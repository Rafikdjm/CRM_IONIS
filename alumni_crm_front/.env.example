# L'authentification admin se fait désormais via JWT (connexion admin côté front).
# Aucune clé API admin ne doit être embarquée dans le bundle frontend.

# Aperçu du code de connexion dans le composant OTPVerification (dev uniquement).
# Mettre à "false" pour masquer complètement le bloc "Code de connexion / Aperçu de l'e-mail reçu".
# Absente ou toute autre valeur = affiché (comportement par défaut en dev).
VITE_SHOW_DEV_PREVIEW=false
