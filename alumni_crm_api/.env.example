# ============================================================================
# Alumni CRM API — modèle de configuration
# Copier ce fichier vers .env puis renseigner les valeurs réelles :
#     cp .env.example .env
# NE JAMAIS committer le fichier .env (contient des secrets).
# ============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alumni_crm
DB_USER=postgres
DB_PASSWORD=
DB_POOL_SIZE=5

# ── Environnement ───────────────────────────────────────────────────────────
# production | development (en development, le rate-limiting OTP est désactivé)
ENV=production

# ── Sécurité ────────────────────────────────────────────────────────────────
# Clé admin exigée dans le header X-API-Key sur les routes /admin/*, import, newsletter
ADMIN_API_KEY=change-me
# Code de connexion administrateur (hashé en SHA-256 côté API)
ADMIN_ACCESS_CODE=change-me
# Secret de signature des sessions JWT
JWT_SECRET=change-me

# ── Authentification OTP ────────────────────────────────────────────────────
# console = le code OTP est affiché dans les logs serveur (développement)
# resend  = envoi réel via l'API Resend (production)
OTP_MODE=console
# Domaine accepté pour la connexion par email académique
ACADEMIC_EMAIL_DOMAIN=ionis-stm.com

# ── Envoi d'emails (Resend) — requis si OTP_MODE=resend ou newsletter ──────
RESEND_API_KEY=
EMAIL_FROM=

# ── RGPD / maintenance ──────────────────────────────────────────────────────
# Délai (mois) avant purge définitive des comptes anonymisés (purge.py)
PURGE_DELAY_MONTHS=6
# Taille maximale des fichiers importés (Mo)
MAX_UPLOAD_SIZE_MB=5
